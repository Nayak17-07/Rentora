# Rentora API & Backend Environment Configuration
PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB_NAME=rentora_db

# High-Entropy JWT Authentication Secret (Generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_64_character_hex_key_here
SECRET_KEY=your_super_secret_64_character_hex_key_here
NODE_ENV=development

# Allowed Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Real-Time Gmail OTP Verification (Optional for local dev)
# If left blank or as placeholders, OTP codes will be printed directly to the server console.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Razorpay Payment Gateway Configuration
# Obtain your Test/Live API keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
